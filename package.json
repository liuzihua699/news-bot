{
  "name": "news-bot",
  "version": "1.0.0",
  "description": "Daily research & tech news digest bot powered by GitHub Actions",
  "type": "module",
  "main": "scripts/run.js",
  "scripts": {
    "start": "node scripts/run.js",
    "daily": "node scripts/daily.js",
    "backfill:daily": "node scripts/backfill-daily.js",
    "weekly": "node scripts/weekly.js",
    "weekly:generate": "node scripts/run-weekly.js",
    "notify": "node scripts/send-report.js",
    "notify:weekly": "node scripts/send-report.js --type weekly",
    "test": "node --test tests/*.test.js",
    "preview": "node server.js"
  },
  "keywords": [
    "rss",
    "news",
    "github-actions",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "rss-parser": "^3.13.0",
    "dayjs": "^1.11.10",
    "openai": "^4.20.0",
    "cheerio": "^1.0.0-rc.12",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.0",
    "marked": "^12.0.0",
    "dotenv": "^16.4.0"
  }
}
